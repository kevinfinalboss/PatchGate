{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/aws/account.schema.json",
  "title": "Patchgate Account (AWS provider)",
  "description": "Rollout settings of one AWS account: its ring and approver groups (ADR 0010). Kept only in the configuration table, never in Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "patchgate.io/v1alpha1"
    },
    "kind": {
      "const": "Account"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[0-9]{12}$",
          "description": "AWS account ID."
        },
        "description": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ring",
        "approvers"
      ],
      "properties": {
        "ring": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "approvers": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "Approver group of the account's instances."
        },
        "allowedApprovers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "description": "Other groups instances may choose with the Patchgate:Approvers tag."
        },
        "allowRingTag": {
          "type": "boolean",
          "default": false,
          "description": "Honour Patchgate:Ring (single-account mode with dev and prod together)."
        }
      }
    }
  }
}
