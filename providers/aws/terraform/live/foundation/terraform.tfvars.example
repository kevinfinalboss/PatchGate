# Copy to terraform.tfvars (git-ignored).
alert_email = "you@example.com"

accounts = {
  hub = {
    name  = "patchgate-hub"
    email = "you+pg-hub@example.com"
    ou    = "security"
  }
  dev = {
    name  = "patchgate-dev"
    email = "you+pg-dev@example.com"
    ou    = "workloads"
  }
  prod = {
    name  = "patchgate-prod"
    email = "you+pg-prod@example.com"
    ou    = "workloads"
  }
}

hub_account_id    = "333333333333"
hub_event_bus_arn = "arn:aws:events:us-east-2:333333333333:event-bus/patchgate-hub"
