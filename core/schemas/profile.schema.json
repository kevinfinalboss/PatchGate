{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/profile.schema.json",
  "title": "Patchgate Profile",
  "description": "What an instance tagged Patchgate:Profile=<name> receives at bootstrap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "patchgate.io/v1alpha1"
    },
    "kind": {
      "const": "Profile"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "description": "Agent names from catalog/agents, installed in this order."
        },
        "hardening": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine"
          ],
          "description": "Hardening applied after agents. Omit for none.",
          "properties": {
            "engine": {
              "enum": [
                "controls",
                "ansible",
                "dsc"
              ],
              "description": "controls = native engine; ansible (Linux) / dsc (Windows) = a Baseline from catalog/baselines."
            },
            "level": {
              "enum": [
                "baseline",
                "cis-level1"
              ],
              "default": "baseline"
            },
            "exclude": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "description": "Control names to skip (documented exceptions)."
            },
            "baseline": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
              "description": "Baseline name (required for engine=ansible)."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "engine": {
                    "enum": [
                      "ansible",
                      "dsc"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "baseline"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "level"
                      ]
                    },
                    {
                      "required": [
                        "exclude"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "engine": {
                    "const": "controls"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "baseline"
                  ]
                }
              }
            }
          ]
        },
        "ring": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "default": 0
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "description": "Periodic re-validation of agents and hardening.",
          "properties": {
            "interval": {
              "enum": [
                "off",
                "30m",
                "1h",
                "2h",
                "6h",
                "12h",
                "24h"
              ],
              "default": "30m"
            },
            "mode": {
              "enum": [
                "enforce",
                "audit"
              ],
              "default": "enforce",
              "description": "enforce corrects drift; audit only reports it."
            }
          }
        },
        "apps": {
          "type": "array",
          "description": "Apps every instance of this profile gets (Chocolatey on Windows, dnf/apt on Linux).",
          "items": {
            "$ref": "#/$defs/app"
          }
        },
        "allowedAppSets": {
          "type": "array",
          "uniqueItems": true,
          "description": "App sets instances may request with the Patchgate:AppSets tag. Default: none.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          }
        }
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$",
          "description": "Package id: Chocolatey on Windows, dnf/apt on Linux."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][0-9A-Za-z.+~:-]{0,49}$",
          "description": "Exact version; omit to take the newest at install time."
        },
        "ensure": {
          "enum": [
            "present",
            "latest",
            "absent"
          ],
          "default": "present"
        }
      }
    }
  }
}
