{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/profile.schema.json",
  "title": "Patchgate Profile",
  "description": "What an instance tagged Patchgate:Profile=<name> receives at bootstrap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "patchgate.io/v1alpha1" },
    "kind": { "const": "Profile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "description": { "type": "string", "maxLength": 300 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": { "enum": ["linux", "windows"] },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
          "description": "Agent names from catalog/agents, installed in this order."
        },
        "chocolatey": {
          "type": "array",
          "description": "Windows only: Chocolatey packages to install or upgrade.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
              "version": { "type": "string", "pattern": "^[0-9][0-9A-Za-z.+-]{0,49}$" }
            }
          }
        },
        "hardening": {
          "enum": ["none", "baseline"],
          "default": "none",
          "description": "Hardening level applied after agents. CIS levels arrive in Phase 3."
        },
        "ring": { "type": "integer", "minimum": 0, "maximum": 9, "default": 0 }
      }
    }
  }
}
