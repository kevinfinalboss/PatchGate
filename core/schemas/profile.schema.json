{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/profile.schema.json",
  "title": "Patchgate Profile",
  "description": "What an instance tagged Patchgate:Profile=<name> receives at bootstrap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "patchgate.io/v1alpha1"
    },
    "kind": {
      "const": "Profile"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "description": "Agent names from catalog/agents, installed in this order."
        },
        "chocolatey": {
          "type": "array",
          "description": "Windows only: Chocolatey packages to install or upgrade.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9][0-9A-Za-z.+-]{0,49}$"
              }
            }
          }
        },
        "hardening": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine"
          ],
          "description": "Hardening applied after agents. Omit for none.",
          "properties": {
            "engine": {
              "enum": [
                "controls"
              ],
              "description": "Hardening engine. 'ansible' and 'dsc' arrive in Phases 3b/3c."
            },
            "level": {
              "enum": [
                "baseline",
                "cis-level1"
              ],
              "default": "baseline"
            },
            "exclude": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "description": "Control names to skip (documented exceptions)."
            }
          }
        },
        "ring": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "default": 0
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "description": "Periodic re-validation of agents and hardening.",
          "properties": {
            "interval": {
              "enum": [
                "off",
                "30m",
                "1h",
                "2h",
                "6h",
                "12h",
                "24h"
              ],
              "default": "30m"
            },
            "mode": {
              "enum": [
                "enforce",
                "audit"
              ],
              "default": "enforce",
              "description": "enforce corrects drift; audit only reports it."
            }
          }
        }
      }
    }
  }
}
