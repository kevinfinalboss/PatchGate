{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/control.schema.json",
  "title": "Patchgate Control",
  "description": "One hardening control for the 'controls' engine: a check (exit 0 = compliant) and an idempotent remediation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "patchgate.io/v1alpha1" },
    "kind": { "const": "Control" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cis": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "level", "check", "remediate"],
      "properties": {
        "platform": { "enum": ["linux", "windows"] },
        "level": {
          "enum": ["baseline", "cis-level1"],
          "description": "Lowest hardening level that includes this control (cis-level1 includes baseline)."
        },
        "check": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "remediate": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}
