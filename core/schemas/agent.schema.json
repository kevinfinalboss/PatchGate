{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/agent.schema.json",
  "title": "Patchgate Agent",
  "description": "Something Patchgate can install on an instance: how to install it per platform and how to prove it is running.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "patchgate.io/v1alpha1" },
    "kind": { "const": "Agent" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install"],
      "properties": {
        "install": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "linux": { "$ref": "#/$defs/linuxInstall" },
            "windows": { "$ref": "#/$defs/windowsInstall" }
          }
        },
        "validate": {
          "type": "object",
          "additionalProperties": false,
          "description": "Command that exits 0 when the agent is installed and running.",
          "properties": {
            "linux": { "$ref": "#/$defs/command" },
            "windows": { "$ref": "#/$defs/command" }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "type": "string", "maxLength": 300 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "httpsUrl": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~%/+-]*)?$" },
    "args": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[^\\r\\n`$;&|<>]*$",
      "description": "Installer arguments. Shell metacharacters are rejected."
    },
    "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "script": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$" },
    "linuxInstall": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "packages"],
          "properties": {
            "method": { "const": "package" },
            "packages": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "description": "Package names from the distribution repositories, per package manager.",
              "properties": {
                "dnf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packageName" } },
                "apt": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packageName" } }
              }
            },
            "postInstall": { "$ref": "#/$defs/script" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "source", "sha256"],
          "properties": {
            "method": { "enum": ["rpm", "deb"] },
            "source": { "$ref": "#/$defs/httpsUrl" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "postInstall": { "$ref": "#/$defs/script" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "script"],
          "properties": {
            "method": { "const": "script" },
            "script": { "$ref": "#/$defs/script" }
          }
        }
      ]
    },
    "windowsInstall": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "package"],
          "properties": {
            "method": { "const": "choco" },
            "package": { "$ref": "#/$defs/packageName" },
            "version": { "type": "string", "pattern": "^[0-9][0-9A-Za-z.+-]{0,49}$" },
            "postInstall": { "$ref": "#/$defs/script" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "source", "sha256"],
          "properties": {
            "method": { "enum": ["msi", "exe"] },
            "source": { "$ref": "#/$defs/httpsUrl" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "args": { "$ref": "#/$defs/args" },
            "postInstall": { "$ref": "#/$defs/script" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "script"],
          "properties": {
            "method": { "const": "script" },
            "script": { "$ref": "#/$defs/script" }
          }
        }
      ]
    }
  }
}
