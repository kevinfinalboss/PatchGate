{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/approvergroup.schema.json",
  "title": "Patchgate ApproverGroup",
  "description": "People who approve rollouts for the instances assigned to the group (by account or by the Patchgate:Approvers tag).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "patchgate.io/v1alpha1"
    },
    "kind": {
      "const": "ApproverGroup"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
          }
        },
        "minApprovals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 1,
          "description": "Distinct members who must approve. Any rejection rejects."
        }
      }
    }
  }
}
