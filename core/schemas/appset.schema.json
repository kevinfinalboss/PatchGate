{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/appset.schema.json",
  "title": "Patchgate AppSet",
  "description": "Reusable bundle of applications. Instances add sets with the Patchgate:AppSets tag; profiles allow-list them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "patchgate.io/v1alpha1"
    },
    "kind": {
      "const": "AppSet"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "apps"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "prune": {
          "type": "boolean",
          "default": true,
          "description": "When the set is removed from an instance, uninstall the apps Patchgate installed for it."
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/app"
          }
        }
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$",
          "description": "Package id: Chocolatey on Windows, dnf/apt on Linux."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][0-9A-Za-z.+~:-]{0,49}$",
          "description": "Exact version; omit to take the newest at install time."
        },
        "ensure": {
          "enum": [
            "present",
            "latest",
            "absent"
          ],
          "default": "present"
        }
      }
    }
  }
}
