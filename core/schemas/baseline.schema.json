{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchgate.io/schemas/v1alpha1/baseline.schema.json",
  "title": "Patchgate Baseline",
  "description": "Third-party hardening content run by an engine other than 'controls' (ADR 0007): an Ansible role (Linux) or a DSC configuration (Windows). Every artifact is pinned by sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "patchgate.io/v1alpha1"
    },
    "kind": {
      "const": "Baseline"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "benchmark": {
              "type": "string",
              "maxLength": 100
            },
            "upstream": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "platform"
      ],
      "properties": {
        "engine": {
          "enum": [
            "ansible",
            "dsc"
          ]
        },
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "source": {
          "$ref": "#/$defs/httpsUrl",
          "description": "Role/playbook archive (.tar.gz); the top-level folder is stripped."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "playbook": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.ya?ml$"
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "source",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "source": {
                "$ref": "#/$defs/httpsUrl"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "variables": {
          "type": "object",
          "description": "Passed to the playbook as extra vars (use it to disable rules or set the level).",
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]{0,99}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "description": "dsc: PowerShell modules (.nupkg) installed as Modules/<name>/<version>.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "source",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,99}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"
              },
              "source": {
                "$ref": "#/$defs/httpsUrl"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "name"
          ],
          "description": "dsc: composite resource applied to localhost.",
          "properties": {
            "module": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,99}$"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$"
            }
          }
        },
        "parameters": {
          "type": "object",
          "description": "dsc: resource parameters (e.g. LevelOne, LevelTwo).",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,99}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "description": "dsc: CIS rule IDs to skip (documented exceptions).",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": {
                "const": "ansible"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "sha256",
              "playbook"
            ],
            "properties": {
              "platform": {
                "const": "linux"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "modules"
                  ]
                },
                {
                  "required": [
                    "resource"
                  ]
                },
                {
                  "required": [
                    "parameters"
                  ]
                },
                {
                  "required": [
                    "exclude"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": {
                "const": "dsc"
              }
            }
          },
          "then": {
            "required": [
              "modules",
              "resource"
            ],
            "properties": {
              "platform": {
                "const": "windows"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source"
                  ]
                },
                {
                  "required": [
                    "playbook"
                  ]
                },
                {
                  "required": [
                    "collections"
                  ]
                },
                {
                  "required": [
                    "variables"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~%/+-]*)?$"
    }
  }
}
